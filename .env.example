# ==============================================================================
# Kibitz Chess Suite — Environment Variables (.env.example)
# Copy to `.env` for local development.
# NOTE: apps/arbiter and apps/seconds NEVER read server secrets or network URLs.
# ==============================================================================

# --- PostgreSQL (used by @suite/db, apps/id, apps/kibitz, apps/hall) ---
POSTGRES_USER=kibitz
POSTGRES_PASSWORD=kibitz_dev_password
POSTGRES_DB=kibitz_suite
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kibitz:kibitz_dev_password@localhost:5432/kibitz_suite

# --- S3-Compatible Object Storage for .pgna files (MinIO locally; R2/S3 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kibitz-pgna
S3_ACCESS_KEY_ID=kibitz_minio_admin
S3_SECRET_ACCESS_KEY=kibitz_minio_dev_secret
S3_FORCE_PATH_STYLE=true
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- Cross-Subdomain Authentication & Sessions (used by apps/id, apps/kibitz, apps/hall) ---
# Generate a strong >= 32-byte secret for production (e.g. `openssl rand -base64 48`)
AUTH_JWT_SECRET=dev-only-replace-me-with-at-least-32-random-bytes
AUTH_JWT_ISSUER=id.kibitz.local
AUTH_JWT_AUDIENCE=kibitz-suite
AUTH_COOKIE_DOMAIN=localhost
AUTH_SESSION_TTL_SECONDS=604800

# --- Backend Service Ports ---
ID_SERVER_PORT=4001
KIBITZ_SERVER_PORT=4002
HALL_SERVER_PORT=4003

# --- Frontend Dev Origins / API Endpoints (Vite) ---
VITE_ID_API_URL=http://localhost:4001
VITE_KIBITZ_API_URL=http://localhost:4002
VITE_HALL_API_URL=http://localhost:4003
VITE_HALL_WS_URL=ws://localhost:4003/ws
