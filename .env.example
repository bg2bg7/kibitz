# ==============================================================================
# Kibitz Chess Suite — Environment Variables (.env.example)
# Copy to `.env` and populate generated local credentials before starting Docker.
# NOTE: apps/arbiter and apps/seconds NEVER read server secrets or network URLs.
# ==============================================================================

# --- PostgreSQL (used by @suite/db, apps/id, apps/kibitz, apps/hall) ---
# Generate a local password before running `docker compose up -d`:
#   openssl rand -hex 24
POSTGRES_USER=kibitz
POSTGRES_PASSWORD=
POSTGRES_DB=kibitz_suite
# Local Compose binds to loopback (127.0.0.1) by default. Override only if intentionally exposing.
# POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
# Replace <POSTGRES_PASSWORD> with the exact value set in POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://kibitz:<POSTGRES_PASSWORD>@localhost:5432/kibitz_suite

# --- Initial Bootstrap Admin (strictly opt-in; runs once on an empty Postgres volume) ---
# Leave both blank to skip admin seeding. To seed an initial admin on first volume boot,
# set INITIAL_ADMIN_HANDLE and a generated INITIAL_ADMIN_PASSWORD (<= 72 UTF-8 bytes, e.g.
# `openssl rand -base64 36`), start Postgres once, then clear INITIAL_ADMIN_PASSWORD from `.env`.
# Changing `.env` afterward does NOT rotate an already-seeded admin or Postgres password.
INITIAL_ADMIN_HANDLE=
INITIAL_ADMIN_PASSWORD=

# --- S3-Compatible Object Storage for .pgna files (RustFS locally; R2/S3 in prod) ---
# Generate independent credentials before running `docker compose up -d`:
#   S3_ACCESS_KEY_ID:     openssl rand -hex 12
#   S3_SECRET_ACCESS_KEY: openssl rand -hex 24
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kibitz-pgna
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Local Compose binds RustFS API and Console to loopback (127.0.0.1) by default.
# S3_BIND_HOST=127.0.0.1
S3_PORT=9000
# S3_CONSOLE_BIND_HOST=127.0.0.1
S3_CONSOLE_PORT=9001

# --- Cross-Subdomain Authentication & Sessions (used by apps/id, apps/kibitz, apps/hall) ---
# Generate a strong >= 32-byte signing secret (required in production):
#   openssl rand -base64 48
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=id.kibitz.local
AUTH_JWT_AUDIENCE=kibitz-suite
AUTH_COOKIE_DOMAIN=localhost
AUTH_SESSION_TTL_SECONDS=604800
# Optional comma-separated extra CORS origins allowed to send credentials to id/lecture/hall
# AUTH_ALLOWED_ORIGINS=https://kibitz.example.org,https://arbiter.kibitz.example.org

# --- Backend Service Ports ---
ID_SERVER_PORT=4001
LECTURE_SERVER_PORT=4002
HALL_SERVER_PORT=4003

# --- Frontend Dev Origins / API Endpoints (Vite) ---
VITE_ID_API_URL=http://localhost:4001
VITE_LECTURE_API_URL=http://localhost:4002
VITE_HALL_API_URL=http://localhost:4003
VITE_HALL_WS_URL=ws://localhost:4003/ws

# --- Optional Cross-Service Web URL Overrides (defaults to localhost ports in dev / subdomains in prod) ---
# VITE_KIBITZ_HOME_URL=http://localhost:5170
# VITE_ID_URL=http://localhost:5171
# VITE_LECTURE_URL=http://localhost:5172
# VITE_HALL_URL=http://localhost:5173
# VITE_SCRIBE_URL=http://localhost:5174
# VITE_ARBITER_URL=http://localhost:5175
# VITE_SECONDS_URL=http://localhost:5176
