{
  "name": "@suite/hall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "pnpm run --parallel '/^dev:/'",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --port 5173",
    "build": "tsc -p tsconfig.server.json && vite build",
