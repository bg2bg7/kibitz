    "@suite/db": "workspace:*",
    "@suite/ui": "workspace:*",
    "hono": "^4.13.20",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@suite/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
